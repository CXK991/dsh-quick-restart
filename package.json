{
  "name": "@cxk991/dsh-quick-restart",
  "version": "1.0.0",
  "description": "侧边栏一键重启 DSH：点一下、确认一次，DSH 自动关闭并重新启动。One-click restart for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "CXK991",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CXK991/dsh-quick-restart.git"
  },
  "homepage": "https://github.com/CXK991/dsh-quick-restart#readme",
  "bugs": {
    "url": "https://github.com/CXK991/dsh-quick-restart/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "harness",
    "restart",
    "relaunch",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "restart.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "index.json",
    "assets/*.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
